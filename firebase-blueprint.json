{
  "entities": {
    "Campus": {
      "title": "Campus",
      "description": "Educational campus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ClassItem": {
      "title": "ClassItem",
      "description": "School class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "campusId": { "type": "string" }
      },
      "required": ["id", "name", "campusId"]
    },
    "ScoreLog": {
      "title": "ScoreLog",
      "description": "Log of score or infraction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "campusId": { "type": "string" },
        "criteriaId": { "type": "string" },
        "criteriaName": { "type": "string" },
        "totalPoints": { "type": "number" },
        "week": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["id", "classId", "week"]
    },
    "LockedWeek": {
      "title": "LockedWeek",
      "description": "Weekly data lock status",
      "type": "object",
      "properties": {
        "week": { "type": "number" },
        "isLocked": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["week", "isLocked"]
    },
    "LockedMonth": {
      "title": "LockedMonth",
      "description": "Monthly data lock status and certification",
      "type": "object",
      "properties": {
        "month": { "type": "number" },
        "isLocked": { "type": "boolean" },
        "lockedAt": { "type": "string" }
      },
      "required": ["month", "isLocked"]
    },
    "Criteria": {
      "title": "Criteria",
      "description": "Emulation criteria rules and points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "points": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "code", "name", "points"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Global school settings",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "academicYear": { "type": "string" }
      },
      "required": ["schoolName"]
    },
    "User": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "HistoricalScore": {
      "title": "HistoricalScore",
      "description": "Preserved weekly historical scores for all school classes",
      "type": "object",
      "properties": {
        "week": { "type": "number" },
        "scores": { "type": "array" },
        "isLocked": { "type": "boolean" },
        "totalClasses": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["week"]
    }
  },
  "firestore": {
    "/historical_scores/{docId}": {
      "schema": { "$ref": "HistoricalScore" },
      "description": "Historical preserved weekly scores for classes"
    },
    "/scores/{scoreId}": {
      "schema": { "$ref": "ScoreLog" },
      "description": "Individual score logs and infractions"
    },
    "/locked_weeks/{weekId}": {
      "schema": { "$ref": "LockedWeek" },
      "description": "Locked weeks data"
    },
    "/locked_months/{monthId}": {
      "schema": { "$ref": "LockedMonth" },
      "description": "Locked months data"
    },
    "/locked_semesters/{docId}": {
      "schema": { "$ref": "LockedMonth" },
      "description": "Locked semesters data"
    },
    "/locked_year/{docId}": {
      "schema": { "$ref": "LockedMonth" },
      "description": "Locked year data"
    },
    "/locked_titles/{docId}": {
      "schema": { "$ref": "LockedMonth" },
      "description": "Locked titles data"
    },
    "/criteria/{criteriaId}": {
      "schema": { "$ref": "Criteria" },
      "description": "Emulation criteria database"
    },
    "/audit_logs/{auditId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Audit trails for system security"
    },
    "/school_settings/{docId}": {
      "schema": { "$ref": "SchoolSettings" },
      "description": "School settings data"
    },
    "/campuses/{docId}": {
      "schema": { "$ref": "Campus" },
      "description": "Campus data"
    },
    "/classes/{docId}": {
      "schema": { "$ref": "ClassItem" },
      "description": "Class data"
    },
    "/users/{docId}": {
      "schema": { "$ref": "User" },
      "description": "User accounts data"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Scores & Score logs (Nhập điểm, Sửa điểm, Xóa điểm)
    match /scores/{scoreId} {
      allow read, write: if true;
    }
    match /score_logs/{logId} {
      allow read, write: if true;
    }
    match /scores_sync/{docId} {
      allow read, write: if true;
    }

    // Chốt tuần (Locked Weeks)
    match /locked_weeks/{weekId} {
      allow read, write: if true;
    }

    // Chốt tháng (Locked Months)
    match /locked_months/{monthId} {
      allow read, write: if true;
    }

    // Chốt học kỳ (Locked Semesters)
    match /locked_semesters/{docId} {
      allow read, write: if true;
    }

    // Chốt năm & Chốt danh hiệu (Locked Year & Titles)
    match /locked_year/{docId} {
      allow read, write: if true;
    }
    match /locked_titles/{docId} {
      allow read, write: if true;
    }

    // Cấu hình tiêu chí (Criteria & Version History)
    match /criteria/{criteriaId} {
      allow read, write: if true;
    }
    match /criteria_sync/{docId} {
      allow read, write: if true;
    }
    match /criteria_versions/{versionId} {
      allow read, write: if true;
    }

    // Nhật ký kiểm toán (Audit Logs)
    match /audit_logs/{auditId} {
      allow read, write: if true;
    }
    match /audit_logs_sync/{docId} {
      allow read, write: if true;
    }

    // Cấu hình trường học & Danh mục
    match /school_settings/{docId} {
      allow read, write: if true;
    }
    match /campuses/{docId} {
      allow read, write: if true;
    }
    match /classes/{docId} {
      allow read, write: if true;
    }
    match /users/{docId} {
      allow read, write: if true;
    }
  }
}

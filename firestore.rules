rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default allow read and write for app operational collections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /classes/{classId} {
      allow read, write: if true;
    }
    match /campuses/{campusId} {
      allow read, write: if true;
    }
    match /criteria/{criteriaId} {
      allow read, write: if true;
    }
    match /score_logs/{logId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /locked_weeks/{docId} {
      allow read, write: if true;
    }
    match /locked_months/{docId} {
      allow read, write: if true;
    }
    match /locked_semesters/{docId} {
      allow read, write: if true;
    }
    match /locked_year/{docId} {
      allow read, write: if true;
    }
    match /locked_titles/{docId} {
      allow read, write: if true;
    }
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /appeals/{appealId} {
      allow read, write: if true;
    }
    match /historical_scores/{docId} {
      allow read, write: if true;
    }
    match /periodic_bonus/{docId} {
      allow read, write: if true;
    }
    match /campus_weekly_duties/{dutyId} {
      allow read, write: if true;
    }
    match /red_flag_members/{memberId} {
      allow read, write: if true;
    }
    match /red_flag_briefings/{briefingId} {
      allow read, write: if true;
    }
    match /red_flag_activity_logs/{logId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
